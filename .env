# Dashboard requires both username and password, WebUI just password. Either can be changed at any time.
# Username defaults to: admin
HERMES_WEBUI_USERNAME=
# Password defaults to: hermes
HERMES_WEBUI_PASSWORD=
# Format address:port for Hermes API server. Defaults to: 127.0.0.1:8642
SERVER_PORT=
# Format address:port for Hermes web user-interface. Defaults to: 127.0.0.1:8787
WEBUI_PORT=
# Format address:port for Hermes configuration dashboard. Defaults to: 127.0.0.1:9119
DASHBOARD_PORT=
# Format address:port for Docker Desktop MCP server integration. Defaults to: 127.0.0.1:8811
MCP_PORT=
# Format address:port for Hindsight memory server. Defaults to: 127.0.0.1:8888
HINDSIGHT_API_PORT=
# Format address:port for Hindsight web user-interface. Defaults to: 127.0.0.1:9999
HINDSIGHT_API_PORT=
# OpenAI API endpoint URL. Defaults to: http://model-runner.docker.internal/v1
CUSTOM_API_ENDPOINT=
# Secret key to use for CUSTOM_API_ENDPOINT. Defaults to: None
CUSTOM_API_KEY=
# Set model to use from one of those available at CUSTOM_API_ENDPOINT
CUSTOM_API_MODEL=
# Set context length for this model (must be at least 64000). Defaults to server setting.
CUSTOM_CONTEXT_LENGTH=
# Browse and edit files from the WebUI, located within C:\Users\<username>\Documents\ (Windows) or $HOME/ (Linux).
# Should not need to be changed, defaults to: Workspace
HERMES_WORKSPACE=
# Lowercase name of Docker Desktop MCP profile to use. Defaults to: default
DOCKER_MCP_PROFILE=
# Secures the Docker Desktop MCP server, and can be changed to a strong secret if required. Defaults to: hermes-mcp-server
MCP_GATEWAY_AUTH_TOKEN=
# Secures the Hermes gateway server, and can be changed to a strong secret if required. Defaults to: hermes-api-server
HERMES_API_AUTH_TOKEN=
# Choose whether us use the Hindsight memory sever (true/false), see later configuration below. Defaults to: false
HERMES_USE_HINDSIGHT=
# Secures the Hindsight memory backend, and can be changed to a strong secret if required. Defaults to: hermes-memory-server
HINDSIGHT_API_KEY=
# Set embedding model for Hindsight memory provider to use, if not set Hindsight will not be configured.
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=
# Set Hindsight embedding model API. Defaults to: openai
HINDSIGHT_API_EMBEDDINGS_PROVIDER=
# Set Hindsight embedding model URL: Defaults to: http://model-runner.docker.internal/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=
# Set Hindsight embedding model API key. Defaults to: None
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=
# Set LLM model for Hindsight memory provider to use, if not set Hindsight will not be configured.
HINDSIGHT_API_LLM_MODEL=
# Set Hindsight LLM API. Defaults to: openai
HINDSIGHT_API_LLM_PROVIDER=
# Set Hindsight LLM URL: Defaults to: http://model-runner.docker.internal/v1
HINDSIGHT_API_LLM_BASE_URL=
# Set Hindsight LLM API key. Defaults to: None
HINDSIGHT_API_LLM_API_KEY=
# Other environment variables referenced in the Docker compose scripts should never need to be changed.
